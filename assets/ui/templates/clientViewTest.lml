<window debug="true" defaultPad="2" width="800">
    <table>
        <table row="true">
            <table row="true">
                <label>AccessToken</label>
                <textField id="accessTokenField"
                    message="client:xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx" />
                <textButton onClick="loadTableDetails">Load Table</textButton>
            </table>
            <table row="true">
                <table row="true">
                    <label id="whoAmI" text="UserName: " />
                    <textField id="whoAmIText" readOnly="true">_notloaded_</textField>
                </table>
                <table row="true">
                    <label id="playerRating" text="Rating: " />
                    <textField id="playerRatingText" readOnly="true">_notloaded_</textField>
                </table>
                <table row="true">
                    <label id="playerIcon" text="Icon#: " />
                    <textField id="playerIconText" readOnly="true">_notloaded_</textField>
                </table>
            </table>
            <table row="true">
                <label id="roomLabel" text="Room: " />
                <label id="tableRoom" text="_null_" row="true" />
                <label id="tableLabel" text="Table: " />
                <label id="tableNumber" text="_null_" row="true" />
                <label id="seatLabel" text="Player Seat: " />
                <label id="playerSeatNumber" text="_null_" row="true" />
            </table>
        </table>
        <table row="true">
            <gameboard id="1:area" width="96" height="208" areanumber="1" preview="false" />
            <gameboard id="2:area" width="96" height="208" areanumber="2" preview="false"
                left="false" />
        </table>
        <table row="true">
            <textButton onClick="startGame" row="true">Start Game</textButton>
            <textButton onChange="goto:debug" row="true">@back</textButton>
        </table>
    </table>
</window>